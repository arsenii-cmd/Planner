<?xml version="1.0" encoding="utf-8"?>
<!-- "Сегодня" widget: header + up to 6 rows (RemoteViews can't use RecyclerView without a service). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/adwaita_mono_bold"
                android:text="Сегодня"
                android:textColor="#FFB5A0"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/adwaita_mono"
                android:textColor="#A08C87"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_add_bg"
            android:fontFamily="@font/adwaita_mono_bold"
            android:gravity="center"
            android:text="+"
            android:textColor="#140C0A"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_0"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_1"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_2"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_3"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_4"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mark_5"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/adwaita_mono_bold"
            android:textColor="#FFB5A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/adwaita_mono"
            android:maxLines="1"
            android:textColor="#F1DFDA"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/adwaita_mono"
        android:gravity="center"
        android:text="Свободный день"
        android:textColor="#A08C87"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/adwaita_mono"
        android:gravity="center"
        android:textColor="#A08C87"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
